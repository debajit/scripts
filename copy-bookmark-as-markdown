#!/usr/bin/env bash

#
# copy-bookmark-as-markdown - Copies a bookmark URL as a Markdown link.
#
# SYNOPSIS
#   copy-bookmark-as-markdown FILE.bookmark
#
# DESCRIPTION
#   Reads the URL from a bookmark file and copies a Markdown link labeled with
#   the filename minus its .bookmark suffix.
#

set -euo pipefail

usage() {
    printf 'Usage: %s FILE.bookmark\n' "${0##*/}" >&2
    exit 2
}

(( $# == 1 )) || usage

bookmark=$1

if [[ ! -f $bookmark ]]; then
    printf '%s: not a file: %s\n' "${0##*/}" "$bookmark" >&2
    exit 1
fi

filename=${bookmark##*/}
if [[ $filename != *.bookmark ]]; then
    printf '%s: expected a .bookmark file: %s\n' "${0##*/}" "$bookmark" >&2
    exit 1
fi

label=${filename%.bookmark}
url=$(<"$bookmark")
url=${url%$'\r'}

if [[ -z $url ]]; then
    printf '%s: bookmark is empty: %s\n' "${0##*/}" "$bookmark" >&2
    exit 1
fi

if [[ $url == *$'\n'* || $url == *$'\r'* ]]; then
    printf '%s: bookmark must contain exactly one URL: %s\n' "${0##*/}" "$bookmark" >&2
    exit 1
fi

markdown="[$label]($url)"

copy_macos() {
    if ! command -v pbcopy >/dev/null 2>&1; then
        printf '%s: pbcopy is not available in PATH\n' "${0##*/}" >&2
        exit 1
    fi

    printf '%s' "$markdown" | pbcopy
}

copy_linux() {
    if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$markdown" | wl-copy --type text/plain
    elif [[ -n ${DISPLAY:-} ]] && command -v xclip >/dev/null 2>&1; then
        printf '%s' "$markdown" | xclip -selection clipboard -t text/plain
    else
        printf '%s: no usable clipboard tool found. Install wl-clipboard for a\n' "${0##*/}" >&2
        printf '%s: Wayland session, or xclip for an X11 one.\n' "${0##*/}" >&2
        exit 1
    fi
}

case $OSTYPE in
    darwin*)
        copy_macos
        ;;
    linux*)
        copy_linux
        ;;
    *)
        printf '%s: unsupported operating system type: %s\n' "${0##*/}" "$OSTYPE" >&2
        exit 1
        ;;
esac

printf 'Copied Markdown link: %s\n' "$markdown"
