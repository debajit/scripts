#!/usr/bin/env bash

#
# copy-bookmark - Copies a bookmark URL as a rich-text hyperlink.
#
# SYNOPSIS
#   copy-bookmark FILE.bookmark
#
# DESCRIPTION
#   Reads the URL from a bookmark file and copies it to the clipboard as a
#   clickable hyperlink labeled with the filename minus its .bookmark suffix.
#
#   On macOS the clipboard carries two flavors: the hyperlink as HTML, and the
#   bare label as plain text.
#
#   On Linux the hyperlink is copied as HTML via wl-copy (Wayland) or xclip
#   (X11). Neither tool can serve a different payload per flavor, so an app
#   that only accepts plain text will paste the raw <a href="...">...</a>
#   markup rather than the label.
#

set -euo pipefail

usage() {
    printf 'Usage: %s FILE.bookmark\n' "${0##*/}" >&2
    exit 2
}

# Prints each argument as its own script-prefixed line on stderr, then exits.
die() {
    local message
    for message in "$@"; do
        printf '%s: %s\n' "${0##*/}" "$message" >&2
    done
    exit 1
}

(( $# == 1 )) || usage

bookmark=$1

[[ -f $bookmark ]] || die "not a file: $bookmark"

filename=${bookmark##*/}
[[ $filename == *.bookmark ]] || die "expected a .bookmark file: $bookmark"

label=${filename%.bookmark}
url=$(<"$bookmark")
url=${url%$'\r'}

[[ -n $url ]] || die "bookmark is empty: $bookmark"

[[ $url != *$'\n'* && $url != *$'\r'* ]] ||
    die "bookmark must contain exactly one URL: $bookmark"

# Sets $escaped rather than printing, so that callers need no subshell.
# The backslashes matter: since bash 5.2 an unescaped & in the replacement
# stands for the matched text.
escape_html() {
    escaped=$1
    escaped=${escaped//&/\&amp;}
    escaped=${escaped//</\&lt;}
    escaped=${escaped//>/\&gt;}
    escaped=${escaped//\"/\&quot;}
}

escape_html "$url"
escaped_url=$escaped
escape_html "$label"

html="<a href=\"$escaped_url\">$escaped</a>"

# Puts $html on the clipboard as text/html, and $label as plain text.
# shellcheck disable=SC2016  # $(...) below is JXA's ObjC bridge, not a subshell
copy_macos() {
    command -v osascript >/dev/null 2>&1 ||
        die 'osascript is not available in PATH'

    osascript -l JavaScript \
        -e 'ObjC.import("AppKit")' \
        -e 'ObjC.import("Foundation")' \
        -e 'function run(argv) {' \
        -e '    var pasteboard = $.NSPasteboard.generalPasteboard;' \
        -e '    pasteboard.clearContents;' \
        -e '    pasteboard.setDataForType($(argv[0]).dataUsingEncoding($.NSUTF8StringEncoding), $("public.html"));' \
        -e '    pasteboard.setStringForType($(argv[1]), $("public.utf8-plain-text"));' \
        -e '}' \
        "$html" "$label"
}

# Puts $html on the clipboard as text/html. Both wl-copy and xclip serve a
# single payload, so plain-text-only apps receive the markup.
copy_linux() {
    if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$html" | wl-copy --type text/html
    elif [[ -n ${DISPLAY:-} ]] && command -v xclip >/dev/null 2>&1; then
        printf '%s' "$html" | xclip -selection clipboard -t text/html
    else
        die 'no usable clipboard tool found. Install wl-clipboard for a' \
            'Wayland session, or xclip for an X11 one.'
    fi
}

case $OSTYPE in
    darwin*)
        copy_macos
        ;;
    linux*)
        copy_linux
        ;;
    *)
        die "unsupported operating system type: $OSTYPE"
        ;;
esac

printf 'Copied hyperlink: %s <%s>\n' "$label" "$url"
