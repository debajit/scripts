#!/bin/bash
# Arch Linux safe cleanup script
# Frees up disk space by cleaning package cache and removing orphans

set -e

echo "Starting Arch Linux cleanup..."

# 1. Remove stale download directories
#
# pacman downloads packages into temporary directories under the cache
# directory. An interrupted transaction leaves those behind, and every
# later `pacman -Sc` run fails trying to read them as package files.
echo "Removing stale download directories from cache..."
sudo find /var/cache/pacman/pkg -maxdepth 1 -type d -name "download-*" -exec rm -rf {} +

# 2. Remove unused package cache
echo "Cleaning package cache (old versions)..."
sudo pacman -Sc

# 3. Remove unused dependencies (orphans)
echo "Checking for orphaned packages..."
# pacman exits non-zero when there are no orphans, which set -e would
# otherwise treat as a fatal error.
orphans=$(pacman -Qdtq || true)

if [ -n "$orphans" ]; then
    echo "Orphaned packages found:"
    echo "$orphans"
    read -p "Do you want to remove these orphaned packages? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        sudo pacman -Rns $orphans
    else
        echo "Skipping orphan removal."
    fi
else
    echo "No orphaned packages found."
fi

# 4. Clear package manager lock and temporary files
echo "Clearing temporary files..."
sudo pacman -Scc --noconfirm

echo "Cleanup complete!"
